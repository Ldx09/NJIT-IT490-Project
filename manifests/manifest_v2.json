{
    "version": "2",
    "bundle_name": "it490_v2.tgz",
    "targets": [
        {
            "role": "frontend",
            "files": [
                {
                    "source": "frontend/index.html",
                    "destination": "/var/www/html/index.html"
                }
            ],
            "service_restart": "apache2"
        },
        {
            "role": "backend",
            "files": [
                {
                    "source": "backend/api.php",
                    "destination": "/var/www/html/api.php"
                }
            ],
            "service_restart": "apache2"
        }
    ]
}
